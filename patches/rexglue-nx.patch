+// MapProcessMemory requires an actual process handle: unlike code-memory SVCs,
+// it rejects CUR_PROCESS_HANDLE. Standalone NROs can lack hbloader's handle.
+// Transfer the pseudo-handle as a copy handle through a local HIPC session, as
+// nx-hbloader does. The kernel places a real handle in this process's table.
+struct SelfProcessHandleRequest {
+    Handle server = INVALID_HANDLE;
+    Handle process = INVALID_HANDLE;
+    Result receive_result = 0;
+};
+
+void ReceiveSelfProcessHandle(void* arg) {
+    auto* request = static_cast<SelfProcessHandleRequest*>(arg);
+    hipcMakeRequestInline(armGetTls());
+    s32 index = 0;
+    request->receive_result = svcReplyAndReceive(&index, &request->server, 1,
+                                                  INVALID_HANDLE, 10000000000ULL);
+    if (R_SUCCEEDED(request->receive_result)) {
+        const HipcParsedRequest parsed = hipcParseRequest(armGetTls());
+        if (parsed.meta.num_copy_handles == 1)
+            request->process = parsed.data.copy_handles[0];
+    }
+    svcCloseHandle(request->server);
+}
+
+Handle ObtainSelfProcessHandle() {
+    SelfProcessHandleRequest request;
+    Handle client = INVALID_HANDLE;
+    Result rc = svcCreateSession(&request.server, &client, 0, 0);
+    if (R_FAILED(rc)) {
+        std::fprintf(stderr, "guest memory: self-handle session failed: %08x\n", rc);
+        return INVALID_HANDLE;
+    }
+    Thread thread;
+    rc = threadCreate(&thread, ReceiveSelfProcessHandle, &request, nullptr, 0x4000, 0x20, 0);
+    if (R_FAILED(rc)) {
+        svcCloseHandle(request.server);
+        svcCloseHandle(client);
+        std::fprintf(stderr, "guest memory: self-handle thread failed: %08x\n", rc);
+        return INVALID_HANDLE;
+    }
+    rc = threadStart(&thread);
+    if (R_FAILED(rc)) {
+        svcCloseHandle(request.server);
+        svcCloseHandle(client);
+        threadClose(&thread);
+        std::fprintf(stderr, "guest memory: self-handle thread start failed: %08x\n", rc);
+        return INVALID_HANDLE;
+    }
+    hipcMakeRequestInline(armGetTls(), .num_copy_handles = 1).copy_handles[0] = CUR_PROCESS_HANDLE;
+    // The receiver closes its endpoint after copying the handle, so a
+    // session-closed send result is expected, just as in nx-hbloader.
+    (void)svcSendSyncRequest(client);
+    svcCloseHandle(client);
+    threadWaitForExit(&thread);
+    threadClose(&thread);
+    if (request.process == INVALID_HANDLE)
+        std::fprintf(stderr, "guest memory: self-handle IPC failed: %08x\n", request.receive_result);
+    return request.process;
+}
+
+Handle Proc() {
+    static const Handle h = [] {
+        const Handle loader = envGetOwnProcessHandle();
+        return loader != INVALID_HANDLE ? loader : ObtainSelfProcessHandle();
+    }();
+    // Keep the old behaviour on failure so the original SVC error is reported.
+    return h != INVALID_HANDLE ? h : CUR_PROCESS_HANDLE;
+}
+
+bool EagerViews() {
+    static const bool eager = envGetOwnProcessHandle() == INVALID_HANDLE;
+    return eager;
+}
 
