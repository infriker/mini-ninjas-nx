+// The full-frame Mini Ninjas prepass can be depth-only with a stale color0
+// register. Match the actual depth surface independently of color bindings:
+// it is not an NFSMW shadow target, so it must not acquire synthetic bias.
+constexpr bool EsProfundidadPrincipalMini(bool enabled, bool tile_ownership, uint32_t surface,
+                                          uint32_t depth, uint32_t expected_depth) {
+  return enabled && !tile_ownership && surface == 0x14020500u && depth == expected_depth;
+}
