+// Audio callback lease state. All operations require AudioSystem's global lock.
+#pragma once
+#include <cstdint>
+
+namespace rex::audio {
+class AudioDriver;
+
+struct AudioClientSlot {
+  AudioDriver* driver = nullptr;
+  uint32_t callback = 0;
+  uint32_t callback_arg = 0;
+  uint32_t wrapped_callback_arg = 0;
+  uint32_t in_flight = 0;
+  bool in_use = false;
+  bool retired = false;
+
+  bool Acquire(uint32_t& out_callback, uint32_t& out_arg) {
+    if (!in_use || retired || !callback || !driver) return false;
+    ++in_flight;
+    out_callback = callback;
+    out_arg = wrapped_callback_arg;
+    return true;
+  }
+
+  // Returns the guest allocation to free, or zero while a lease remains.
+  uint32_t Retire() {
+    retired = true;
+    callback = 0;
+    return ReclaimIfIdle();
+  }
+
+  uint32_t Complete() {
+    if (!in_flight) return 0;
+    --in_flight;
+    return ReclaimIfIdle();
+  }
+
+  uint32_t ReclaimIfIdle() {
+    if (!retired || in_flight) return 0;
+    const uint32_t ptr = wrapped_callback_arg;
+    *this = {};
+    return ptr;
+  }
+};
+}  // namespace rex::audio
