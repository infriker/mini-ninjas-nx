+void AudioSystem::ReleaseCallback(size_t index) {
+  auto global_lock = global_critical_region_.Acquire();
+  const uint32_t ptr = clients_[index].Complete();
+  if (ptr) memory()->SystemHeapFree(ptr);
+}
+
+void AudioSystem::DrainClientSemaphore(size_t index) {
+  auto* semaphore = client_semaphores_[index].get();
+  while (rex::thread::Wait(semaphore, false, std::chrono::milliseconds(0)) ==
+         rex::thread::WaitResult::kSuccess) {}
+}
