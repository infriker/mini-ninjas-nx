+  // The game and decoder own different fields, sometimes in the same big-endian word.
+  // A live update must not copy back either the other side's cursor or its valid bits.
+  static constexpr uint32_t kPacketCount = 0xfff, kLoopCount = 0xffu << 12;
+  static constexpr uint32_t kInput0Valid = 1u << 20, kInput1Valid = 1u << 21;
+  static constexpr uint32_t kOutputWrite = 31u << 27, kOutputRead = 31;
+  static constexpr uint32_t kBitOffset = (1u << 26) - 1, kError = 31u << 26;
+  static constexpr uint32_t kCurrentInput = 1u << 31, kOutputValid = 1u << 31;
+
+  static void UpdateWord(void* ptr, size_t index, uint32_t mask, uint32_t bits) {
+    auto word = std::atomic_ref<uint32_t>(static_cast<uint32_t*>(ptr)[index]);
+    const uint32_t value = rex::byte_swap(bits & mask);
+    if (mask == UINT32_MAX) {
+      word.store(value, std::memory_order_release);
+      return;
+    }
+    const uint32_t keep = rex::byte_swap(~mask);
+    uint32_t seen = word.load(std::memory_order_relaxed);
+    while (!word.compare_exchange_weak(seen, (seen & keep) | value,
+                                      std::memory_order_release, std::memory_order_relaxed)) {}
+  }
