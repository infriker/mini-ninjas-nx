+bool RenderDk::AlturaAjustada() const {
+  return REXCVAR_GET(deko_altura_destino_ajustada) && !REXCVAR_GET(deko_edram_baldosas) &&
+         vs_salida_valido_ && fs_copia_color_valido_ && fs_copia_zs_valido_;
+}
+
+uint32_t RenderDk::AlturaDestino(uint32_t pitch, uint32_t requerida, bool ajustar) const {
+  if (ajustar && AlturaAjustada()) return target_extent::Height(requerida);
+  const uint32_t minimo = uint32_t(std::clamp(REXCVAR_GET(deko_altura_minima_destino), 720, int32_t(kAltoMaximoDestino)));
+  return std::min(kAltoMaximoDestino, std::max(minimo, (pitch + 15) & ~15u));
+}
+
+bool RenderDk::AsegurarAlturaDestino(ImagenDk& imagen, uint32_t requerida) {
+  if (!AlturaAjustada() || requerida <= imagen.alto) return true;
+  const uint32_t alto = target_extent::Height(requerida);
+  if (alto <= imagen.alto) return true;
+  // Allocate first: failure must leave the live target and deferred snapshot intact.
+  ImagenDk nueva;
+  uint32_t flags = DkImageFlags_UsageRender | (imagen.profundidad ? 0u : DkImageFlags_Usage2DEngine);
+  if (imagen.profundidad ? REXCVAR_GET(nfsmw_dk_compresion_profundidad) : REXCVAR_GET(nfsmw_dk_compresion_color)) {
+    flags |= DkImageFlags_HwCompression;
+  }
+  if (!CrearImagen(nueva, DkImageType_2D, imagen.formato, imagen.ancho, alto, 1, 1, flags, "ampliar destino")) {
+    return false;
+  }
+  AntesDeCambiarDestino(&imagen);
+  TerminarPase();
+  RestaurarContenido(imagen, true);
+  HacerBorradoPendiente(imagen);
+  CompletarBanda(imagen, imagen.alto, false, 0);
+  LeerMuestras(imagen);  // preserve every old depth/stencil sample before retiring the companion
+  AsegurarTrabajo();
+  AntesDe3D();
+  const DkImageView vista = VistaCompleta(nueva.imagen);
+  if (nueva.profundidad) dkCmdBufBindRenderTargets(nucleo_.comandos(), nullptr, 0, &vista);
+  else dkCmdBufBindRenderTarget(nucleo_.comandos(), &vista, nullptr);
+  // Unallocated rows have never been drawn; their value is the last logical whole clear.
+  nueva.borrado_z = imagen.borrado_z;
+  nueva.borrado_estencil = imagen.borrado_estencil;
+  std::copy(std::begin(imagen.borrado_color), std::end(imagen.borrado_color), nueva.borrado_color);
+  BorrarFilas(nueva, 0, 0, alto);
+  if (!Copiar3D(imagen, 0, 0, imagen.ancho, imagen.alto, nueva, 0, 0, kCopiaValor, 1.0f, 1,
+                imagen.profundidad)) {
+    DestruirImagen(nueva);
+    OlvidarEstado();
+    return false;
+  }
+  ImagenDk vieja = imagen;
+  borrado_previo_.erase(imagen.serie);
+  imagen.imagen = nueva.imagen;
+  imagen.memoria = nueva.memoria;
+  imagen.serie = nueva.serie;
+  imagen.alto = alto;
+  imagen.alto_borrado = alto;
+  imagen.banda_sucia = false;
+  imagen.borrado_pendiente = false;
+  imagen.ms_nueva = false;
+  imagen.ms_ligada = false;
+  imagen.ms_filas = 0;
+  imagen.s_nueva = true;
+  ++generacion_texturas_;
+  DestruirImagen(vieja);  // deferred retirement keeps already submitted GPU work valid
+  OlvidarEstado();
+  return true;
+}
