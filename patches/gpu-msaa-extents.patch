+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace rex::x360::target_extent {
+
+// Keep allocation in sample rows, independently of native/sample-space drawing.
+constexpr uint32_t Height(uint32_t required) {
+  return (std::clamp(required, 32u, 2048u) + 31u) & ~31u;
+}
+
+constexpr uint32_t DrawHeight(uint32_t surface, uint32_t top_left,
+                              uint32_t bottom_right, uint32_t window_offset) {
+  int32_t bottom = int32_t((bottom_right >> 16) & 0x3FFFu);
+  if (!(top_left & 0x80000000u)) {
+    const uint32_t raw = (window_offset >> 16) & 0x7FFFu;
+    bottom += raw < 0x4000u ? int32_t(raw) : int32_t(raw) - 0x8000;
+  }
+  const uint32_t scale = ((surface >> 16) & 3u) == 2u ? 2u : 1u;
+  return std::min(uint32_t(std::max(bottom, 0)) * scale, 2048u);
+}
+
+// x/y are in sample rows for colour, but in pixels for the depth copy shader.
+constexpr bool Direct4x(bool depth, uint32_t samples, uint32_t x, uint32_t y,
+                        uint32_t width, uint32_t height, uint32_t source_width,
+                        uint32_t valid_rows) {
+  if (samples != 2 || !width || !height || (!depth && ((x | y) & 1u))) return false;
+  const uint64_t right = (depth ? uint64_t(x) * 2 : x) + uint64_t(width) * 2;
+  const uint64_t bottom = (depth ? uint64_t(y) * 2 : y) + uint64_t(height) * 2;
+  return right <= source_width && bottom <= valid_rows;
+}
+
+}  // namespace rex::x360::target_extent
