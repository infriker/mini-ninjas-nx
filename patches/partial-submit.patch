+    if (ahora - ultimo_swap_ns_ > 33'333'333) ++v.lentos;
+    if (ahora - v.inicio < 10'000'000'000ull) return;
+    const uint64_t trabajos = gpu_trabajos_ - v.trabajos_gpu;
+    REXLOG_WARN("[partial-submit] interval={} frames={} fps={:.1f} over33ms={} draws/frame={:.1f} "
+                "partials={} previous_game_fence_ready={}/{} game_gap_ms/work={:.2f} measured_works={}",
+                intervalo_envio_parcial_, v.fotogramas, v.fotogramas * 1e9 / double(ahora - v.inicio),
+                v.lentos, double(dibujados_ - v.dibujos) / v.fotogramas, v.parciales, v.previos_listos,
+                v.sondeos, trabajos ? double(hueco - v.hueco_gpu_ns) / (1e6 * trabajos) : 0.0, trabajos);
+  }
+  v = {.inicio = ahora, .dibujos = dibujados_, .trabajos_gpu = gpu_trabajos_, .hueco_gpu_ns = hueco};
+}
