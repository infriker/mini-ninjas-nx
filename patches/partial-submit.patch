+void RenderDk::TrasDibujoParaEnvio() {
+  ++dibujos_sin_envio_;
+  // Once per work, before its first split. A completed previous game fence
+  // means this chunk could already have fed the GPU. Never wait on the CPU.
+  if (medir_envios_parciales_ && !sondeo_hecho_ && trabajo_ > 1 &&
+      dibujos_sin_envio_ == (intervalo_envio_parcial_ ? std::min(128u, intervalo_envio_parcial_) : 128u)) {
+    ++ventana_envios_.sondeos;
+    ventana_envios_.previos_listos += nucleo_.TrabajoTerminado(trabajo_ - 1);
+    sondeo_hecho_ = true;
+  }
+  if (!intervalo_envio_parcial_ || dibujos_sin_envio_ < intervalo_envio_parcial_ || cielo_pendiente_) return;
+
+  // Retain the same work, upload storage, GPU timestamps and eventual slot fence.
+  // The MSAA companions retain their pixels and pending clears keep their ordering.
+  TerminarPase();
+  nucleo_.EnviarParcial();
+  // The presenter can use the shared queue between these lists. Restart at 1x;
+  // EmpezarPase rebinds the guest targets and selects their actual sample mode.
+  DkMultisampleState una;
+  dkMultisampleStateDefaults(&una);
+  dkCmdBufBindMultisampleState(nucleo_.comandos(), &una);
+  RestablecerListaDeDibujos();
+  dibujos_sin_envio_ = 0;
+  if (medir_envios_parciales_) ++ventana_envios_.parciales;
+}
